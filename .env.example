# Frontend build-time settings (copy to .env.local). None of these are secrets: they end up in the public bundle.
# Leave a value empty and the policy pages show a marked placeholder instead of an invented detail.
VITE_COMPANY_NAME=
VITE_COMPANY_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_GRIEVANCE_OFFICER=
# Where the site is served from, for canonical links (no trailing slash)
VITE_PUBLIC_URL=
# API base when the API is on another origin (leave empty to use the same origin / dev proxy)
VITE_API_URL=
